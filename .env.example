APP_NAME=Nestor Security Scanner
APP_ENV=development
WEB_PORT=8080
LOG_LEVEL=INFO

# Optional API key for mutating endpoints (X-API-Key). Empty = unprotected (local demo only).
API_KEY=

DATA_DIR=/data
REPORTS_DIR=/data/reports
DATABASE_URL=sqlite:////data/scanner.db

REDIS_URL=redis://redis:6379/0
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_MINUTES=30

POLICY_FILE=/policies/default.yaml

HARBOR_ENABLED=false
HARBOR_URL=https://harbor.example.ru
HARBOR_USERNAME=
HARBOR_PASSWORD=
HARBOR_VERIFY_TLS=true
HARBOR_PROJECTS=
HARBOR_WEBHOOK_SECRET=

DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=60

GRYPE_DB_CACHE_DIR=/data/grype-db
GRYPE_DB_AUTO_UPDATE=true
GRYPE_DB_UPDATE_INTERVAL_HOURS=24

REPORT_RETENTION_DAYS=30
