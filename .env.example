APP_NAME=Nestor Security Scanner
APP_ENV=development
WEB_PORT=8080
LOG_LEVEL=INFO

# --- Auth ---
# Admin bootstrapped on first run from ADMIN_USER/ADMIN_PASSWORD (only if users table is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Used to sign session cookies. Set to a long random string in production.
SESSION_SECRET=change-me-in-prod-please-32-chars-minimum
SESSION_MAX_AGE_SECONDS=43200
# Optional API key for mutating endpoints (X-API-Key). Empty = unprotected (local demo only).
API_KEY=

DATA_DIR=/data
REPORTS_DIR=/data/reports
DATABASE_URL=sqlite:////data/scanner.db

REDIS_URL=redis://redis:6379/0
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_MINUTES=30

POLICY_FILE=/policies/default.yaml

# --- Harbor ---
HARBOR_ENABLED=false
HARBOR_URL=https://harbor.example.ru
HARBOR_USERNAME=
HARBOR_PASSWORD=
HARBOR_VERIFY_TLS=true
HARBOR_PROJECTS=
HARBOR_WEBHOOK_SECRET=

# --- GitHub Container Registry (ghcr.io) ---
# PAT with read:packages scope. Empty = GitHub UI disabled.
GITHUB_TOKEN=

DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=60

GRYPE_DB_CACHE_DIR=/data/grype-db
GRYPE_DB_AUTO_UPDATE=true
GRYPE_DB_UPDATE_INTERVAL_HOURS=24

# --- Auto-rescan after successful Grype DB update ---
RESCAN_AFTER_DB_UPDATE=true
RESCAN_RECENT_DAYS=30

REPORT_RETENTION_DAYS=30
